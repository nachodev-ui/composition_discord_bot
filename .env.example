# Credenciales de la aplicación de Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Canal de texto donde se publica el signup y se escriben los números
ROLE_SELECTION_CHANNEL_ID=

# Catálogo y estado persistente
BUILD_CONFIG_PATH=config/builds.json
SIGNUP_STATE_PATH=data/signup-state.json

# Comportamiento
ROLE_REPLACEMENT_ENABLED=true
AUTO_CREATE_MISSING_ROLES=false
AUTO_PUBLISH_PANEL=true
SELECTION_COOLDOWN_SECONDS=3

# Operación
PORT=3000
LOG_LEVEL=info
