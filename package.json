{
  "name": "composition-discord-bot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Bot de Discord para signup numerado, roles de composición y builds obligatorias de Albion Online.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "images:validate": "node scripts/validateBuildImages.mjs assets/builds/05-bear-paws-x2.png",
    "check": "pnpm lint && pnpm test && pnpm build && pnpm images:validate",
    "commands:register": "tsx src/discord/registerCommands.ts",
    "config:validate": "tsx src/config/validateBuildConfig.ts"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "17.4.2",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
