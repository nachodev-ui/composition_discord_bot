{
  "name": "composition-discord-bot",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de administración de composiciones de Albion Online con panel web, API y bot de Discord.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "check": "pnpm lint && pnpm test && pnpm build",
    "commands:register": "tsx src/discord/registerCommands.ts",
    "db:migrate": "tsx scripts/applyMigrations.ts",
    "db:import-legacy": "tsx scripts/importLegacyBuilds.ts",
    "db:verify": "tsx scripts/verifyDatabase.ts",
    "config:validate": "tsx src/config/validateBuildConfig.ts"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
